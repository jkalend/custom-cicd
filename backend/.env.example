# Copy to backend/.env if you need overrides. The local Laya gateway needs
# no key; defaults point at http://127.0.0.1:8128/v1/evaluate.
# Optional overrides:
# LAYA_GATEWAY_URL=http://127.0.0.1:8128/v1/evaluate
# LAYA_MODEL=convaiinnovations/laya
# LAYA_GATEWAY_TOKEN=   # only if the gateway was started with LAYA_GATEWAY_TOKEN
# LAYA_TIMEOUT=10
